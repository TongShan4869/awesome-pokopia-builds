---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "awesome-pokopia-builds",
  description = "A cute gallery of inspiring Pokemon Pokopia builds from social videos.",
} = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${basePath}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
