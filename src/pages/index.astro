---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import catalog from "../../data/pokopia-item-catalog.json";

const builds = (await getCollection("builds")).sort((a, b) => {
  const capturedAt = (value?: string) => {
    const timestamp = Date.parse(value ?? "");
    return Number.isNaN(timestamp) ? 0 : timestamp;
  };
  const capturedAtDifference = capturedAt(b.data.capturedAt) - capturedAt(a.data.capturedAt);

  return capturedAtDifference || a.data.title.localeCompare(b.data.title);
});
const allTags = [...new Set(builds.flatMap((build) => build.data.tags))].sort();
const itemCatalogCount = catalog.items.filter((item) => item.imageAvailable && item.image).length;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (asset: string) => `${basePath}${asset.replace(/^\//, "")}`;
const shareUrl = "https://tongshan4869.github.io/awesome-pokopia-builds/?v=2";
const shareTitle = "awesome-pokopia-builds";
const shareText = "A cute gallery of inspiring Pokemon Pokopia builds from social videos.";
const encodedShareUrl = encodeURIComponent(shareUrl);
const encodedShareTitle = encodeURIComponent(shareTitle);
const encodedShareText = encodeURIComponent(shareText);
const socialShareLinks = [
  {
    label: "Discord",
    icon: "D",
    className: "share-icon-discord",
    copy: true,
  },
  {
    label: "X",
    icon: "X",
    className: "share-icon-x",
    href: `https://twitter.com/intent/tweet?url=${encodedShareUrl}&text=${encodedShareText}`,
  },
  {
    label: "Reddit",
    icon: "r",
    className: "share-icon-reddit",
    href: `https://www.reddit.com/submit?url=${encodedShareUrl}&title=${encodedShareTitle}`,
  },
  {
    label: "Bluesky",
    icon: "b",
    className: "share-icon-bluesky",
    href: `https://bsky.app/intent/compose?text=${encodedShareText}%20${encodedShareUrl}`,
  },
];
---

<BaseLayout>
  <main class="site-shell">
    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav-inner">
        <a class="site-nav-brand" href={basePath}>
          <span>Pokopia</span>
          <strong>Builds</strong>
        </a>
        <div class="site-nav-links">
          <a href="#gallery">Builds</a>
          <a href={`${basePath}items/`}>Items</a>
          <a href={`${basePath}nominate/`}>Nominate</a>
          <div class="share-menu nav-share-menu" data-share-menu>
            <button class="site-nav-share" type="button" aria-expanded="false" aria-controls="share-panel" data-share-trigger>
              Share
            </button>
          </div>
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Community build gallery</p>
        <h1>
          Awesome<br />
          <span class="hero-title-tail">
            <em class="logo-word" aria-label="Pokopia">
              <span aria-hidden="true">P</span><span aria-hidden="true">o</span><span aria-hidden="true">k</span><span aria-hidden="true">o</span><span aria-hidden="true">p</span><span aria-hidden="true">i</span><span aria-hidden="true">a</span>
            </em>
            Builds
          </span>
        </h1>
        <p class="hero-text">
          A gallery of awesome Pokémon Pokopia builds discovered on social media.<br />
          Save inspiring builds, study the details, and find the items behind each idea.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#gallery">Browse builds</a>
          <a class="button secondary" href={`${basePath}nominate/`}>Nominate a build</a>
          <a class="button secondary" href={`${basePath}items/`}>Item catalog</a>
        </div>
      </div>
      <div class="hero-specimen" aria-label="Decorative Pokopia gallery preview">
        <div class="specimen-frame">
          <img
            src={assetPath("images/hero/pokopia-pastel-landscape.png")}
            alt="Pastel Pokopia landscape with Pokemon, gardens, trees, and the Pokopia logo"
          />
        </div>
      </div>
    </section>

    <section class="toolbar" aria-label="Gallery summary">
      <div>
        <span class="metric">{builds.length}</span>
        <span class="label">curated builds</span>
      </div>
      <div>
        <span class="metric">{allTags.length}</span>
        <span class="label">themes</span>
      </div>
      <div>
        <span class="metric">{itemCatalogCount}</span>
        <span class="label">catalog figures</span>
      </div>
    </section>

    <div class="explore-grid">
      <section class="catalog-preview catalog-preview-featured catalog-preview-community" aria-label="Build nominations">
        <div>
          <p class="eyebrow">Know a great build?</p>
          <h2>Share a build you love</h2>
          <p>
            Found a build you love? Send over the source link and a short note, and we'll take it
            from there. Let's build together!
          </p>
        </div>
        <a class="text-link" href={`${basePath}nominate/`}>Nominate build <span aria-hidden="true">→</span></a>
      </section>

      <section class="catalog-preview catalog-preview-catalog" aria-label="Item catalog preview">
        <div>
          <p class="eyebrow">Item reference</p>
          <h2>Items list for visual inventory notes</h2>
          <p>
            Browse item names and figures alongside builds to create useful visual inventory notes
            for later reference.
          </p>
        </div>
        <a class="text-link" href={`${basePath}items/`}>Open catalog <span aria-hidden="true">→</span></a>
      </section>
    </div>

    {builds.length > 0 && (
      <>
        <section class="catalog-controls build-controls" aria-label="Build filters">
          <label>
            <span>Search builds</span>
            <input type="search" id="build-search" placeholder="Garden, cottage, market..." />
          </label>
          <label>
            <span>Theme</span>
            <select id="theme-filter">
              <option value="">All themes</option>
              {allTags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>
        </section>
        <p class="catalog-result-count build-result-count" id="build-result-count">
          {builds.length} visible builds
        </p>
      </>
    )}

    <section id="gallery" class="gallery" aria-label="Pokopia build gallery">
      {builds.length === 0 ? (
        <div class="empty-state">
          <p class="eyebrow">No builds exported yet</p>
          <h2>Drop in your first social link locally.</h2>
          <p>
            Run <code>corepack pnpm ingest "&lt;url&gt;"</code>, review the private curation
            draft, then export a public build page when the screenshot and notes feel right.
          </p>
        </div>
      ) : (
        builds.map((build) => (
          <a
            class="build-card"
            href={`${basePath}builds/${build.slug}/`}
            data-build-card
            data-title={build.data.title.toLowerCase()}
            data-summary={build.data.summary.toLowerCase()}
            data-creator={build.data.creator.toLowerCase()}
            data-platform={build.data.platform.toLowerCase()}
            data-tags={JSON.stringify(build.data.tags.map((tag) => tag.toLowerCase()))}
          >
            <img src={assetPath(build.data.heroImage)} alt={`${build.data.title} full build screenshot`} loading="lazy" />
            <div class="build-card-copy">
              <p>{build.data.platform} · {build.data.creator}</p>
              <h2>{build.data.title}</h2>
              <span>{build.data.summary}</span>
            </div>
            <div class="chip-row">
              {build.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        ))
      )}
    </section>
  </main>

  <div class="share-panel" id="share-panel" data-share-panel hidden>
    <div class="share-backdrop" data-share-close></div>
    <section class="share-dialog" role="dialog" aria-modal="true" aria-labelledby="share-title">
      <button class="share-close" type="button" aria-label="Close share dialog" data-share-close>
        <span aria-hidden="true">×</span>
      </button>
      <h2 id="share-title">Share this gallery</h2>
      <div class="share-links" aria-label="Social share links">
        {socialShareLinks.map((link) => (
          link.copy ? (
            <button type="button" data-share-copy>
              <span class:list={["share-icon", link.className]} aria-hidden="true">{link.icon}</span>
              <span>{link.label}</span>
            </button>
          ) : (
          <a href={link.href} target="_blank" rel="noreferrer">
            <span class:list={["share-icon", link.className]} aria-hidden="true">{link.icon}</span>
            <span>{link.label}</span>
          </a>
          )
        ))}
      </div>
      <label class="share-copy">
        <span>Share link</span>
        <input type="url" value={shareUrl} readonly data-share-input />
      </label>
      <button class="button primary share-copy-button" type="button" data-share-copy>
        Copy link
      </button>
      <p class="share-status" aria-live="polite" data-share-status></p>
    </section>
  </div>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#build-search");
    const themeFilter = document.querySelector<HTMLSelectElement>("#theme-filter");
    const resultCount = document.querySelector<HTMLElement>("#build-result-count");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-build-card]")];
    const shareTrigger = document.querySelector<HTMLButtonElement>("[data-share-trigger]");
    const sharePanel = document.querySelector<HTMLElement>("[data-share-panel]");
    const shareInput = document.querySelector<HTMLInputElement>("[data-share-input]");
    const shareCopyControls = [...document.querySelectorAll<HTMLButtonElement>("[data-share-copy]")];
    const shareStatus = document.querySelector<HTMLElement>("[data-share-status]");
    const shareCloseControls = [...document.querySelectorAll<HTMLElement>("[data-share-close]")];

    function updateGallery() {
      const query = searchInput?.value.trim().toLowerCase() ?? "";
      const theme = themeFilter?.value.toLowerCase() ?? "";
      let visibleCount = 0;

      for (const card of cards) {
        const haystack = [
          card.dataset.title,
          card.dataset.summary,
          card.dataset.creator,
          card.dataset.platform,
          card.dataset.tags,
        ].join(" ");
        const tags = JSON.parse(card.dataset.tags ?? "[]");
        const matchesQuery = query === "" || haystack.includes(query);
        const matchesTheme = theme === "" || tags.includes(theme);
        const visible = matchesQuery && matchesTheme;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      if (resultCount) {
        resultCount.textContent = `${visibleCount} visible ${visibleCount === 1 ? "build" : "builds"}`;
      }
    }

    searchInput?.addEventListener("input", updateGallery);
    themeFilter?.addEventListener("change", updateGallery);
    updateGallery();

    function setSharePanel(open: boolean) {
      if (!sharePanel || !shareTrigger) return;

      sharePanel.hidden = !open;
      shareTrigger.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("is-share-open", open);
      if (!open && shareStatus) shareStatus.textContent = "";
      if (open) {
        sharePanel.querySelector<HTMLElement>(".share-close")?.focus();
      }
    }

    shareTrigger?.addEventListener("click", () => {
      setSharePanel(Boolean(sharePanel?.hidden));
    });

    async function copyShareLink(message: string) {
      if (!shareInput || !shareStatus) return;

      try {
        await navigator.clipboard.writeText(shareInput.value);
        shareStatus.textContent = message;
      } catch {
        shareInput.focus();
        shareInput.select();
        shareStatus.textContent = "Select and copy.";
      }
    }

    shareCopyControls.forEach((control) => {
      control.addEventListener("click", () => {
        copyShareLink(control.closest(".share-links") ? "Copied for Discord." : "Copied.");
      });
    });

    shareCloseControls.forEach((control) => {
      control.addEventListener("click", () => setSharePanel(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setSharePanel(false);
    });
  </script>
</BaseLayout>
