---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import catalog from "../../data/pokopia-item-catalog.json";
import { tagSlug } from "../utils/tags";

const builds = (await getCollection("builds")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const allTags = [...new Set(builds.flatMap((build) => build.data.tags))].sort();
const itemCatalogCount = catalog.items.filter((item) => item.imageAvailable && item.image).length;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (asset: string) => `${basePath}${asset.replace(/^\//, "")}`;
const repoUrl =
  import.meta.env.PUBLIC_REPO_URL || "https://github.com/TongShan4869/awesome-pokopia-builds";
---

<BaseLayout>
  <main class="site-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Pokopia build scrapbook</p>
        <h1>Awesome Pokopia Builds</h1>
        <p class="hero-text">
          A curated gallery of Pokopia builds discovered in social videos, with screenshots,
          creator credit, and clean item notes for later remixing.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#gallery">Browse builds</a>
          <a class="button secondary" href={`${basePath}nominate/`}>Nominate a build</a>
          <a class="button secondary" href={`${basePath}items/`}>Item catalog</a>
          <a class="button secondary" href={repoUrl} rel="noreferrer">View repo</a>
        </div>
      </div>
      <div class="hero-specimen" aria-label="Decorative Pokopia gallery preview">
        <div class="specimen-frame">
          <div class="mini-sun"></div>
          <div class="cloud cloud-one"></div>
          <div class="cloud cloud-two"></div>
          <div class="build-base"></div>
          <div class="center-shadow"></div>
          <div class="poke-center">
            <span class="roof"></span>
            <span class="roof-band"></span>
            <span class="front"></span>
            <span class="side side-left"></span>
            <span class="side side-right"></span>
            <span class="door"></span>
            <span class="emblem"></span>
            <span class="window window-left"></span>
            <span class="window window-right"></span>
          </div>
          <div class="plaza"></div>
          <div class="stairs stairs-center"></div>
          <div class="phone-kiosk"></div>
          <div class="chalk-sign"></div>
          <div class="lamp lamp-one"></div>
          <div class="lamp lamp-two"></div>
          <div class="pokopia-logo-card">Pokopia</div>
          <div class="tiny-figure figure-trainer">
            <span class="hair"></span>
            <span class="face"></span>
            <span class="body"></span>
          </div>
          <div class="tiny-figure figure-companion">
            <span class="fluff fluff-one"></span>
            <span class="fluff fluff-two"></span>
            <span class="fluff fluff-three"></span>
            <span class="fluff fluff-four"></span>
            <span class="horn"></span>
            <span class="face"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="toolbar" aria-label="Gallery summary">
      <div>
        <span class="metric">{builds.length}</span>
        <span class="label">curated builds</span>
      </div>
      <div>
        <span class="metric">{allTags.length}</span>
        <span class="label">themes</span>
      </div>
      <div>
        <span class="metric">{itemCatalogCount}</span>
        <span class="label">catalog figures</span>
      </div>
    </section>

    <section class="catalog-preview" aria-label="Item catalog preview">
      <div>
        <p class="eyebrow">Item reference</p>
        <h2>Exact item figures for visual inventory notes.</h2>
        <p>
          The gallery can pair builds with precise item names and figures, so screenshot notes
          become useful reference material instead of loose material guesses.
        </p>
      </div>
      <a class="button primary" href={`${basePath}items/`}>Open catalog</a>
    </section>

    <section class="catalog-preview" aria-label="Build nominations">
      <div>
        <p class="eyebrow">Know a great build?</p>
        <h2>Send a link for the curator batch.</h2>
        <p>
          Visitors can nominate builds with a source link and short description. We still handle
          screenshots, item notes, data processing, and publishing locally.
        </p>
      </div>
      <a class="button primary" href={`${basePath}nominate/`}>Nominate build</a>
    </section>

    {allTags.length > 0 && (
      <section class="tag-ribbon" aria-label="Build themes">
        {allTags.map((tag) => <a href={`${basePath}tags/${tagSlug(tag)}/`}>{tag}</a>)}
      </section>
    )}

    <section id="gallery" class="gallery" aria-label="Pokopia build gallery">
      {builds.length === 0 ? (
        <div class="empty-state">
          <p class="eyebrow">No builds exported yet</p>
          <h2>Drop in your first social link locally.</h2>
          <p>
            Run <code>corepack pnpm ingest "&lt;url&gt;"</code>, review the private curation
            draft, then export a public build page when the screenshot and notes feel right.
          </p>
        </div>
      ) : (
        builds.map((build) => (
          <a class="build-card" href={`${basePath}builds/${build.slug}/`}>
            <img src={assetPath(build.data.heroImage)} alt={`${build.data.title} full build screenshot`} loading="lazy" />
            <div class="build-card-copy">
              <p>{build.data.platform} · {build.data.creator}</p>
              <h2>{build.data.title}</h2>
              <span>{build.data.summary}</span>
            </div>
            <div class="chip-row">
              {build.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        ))
      )}
    </section>
  </main>
</BaseLayout>
