---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import catalog from "../../data/pokopia-item-catalog.json";

const builds = (await getCollection("builds")).sort((a, b) => {
  const capturedAt = (value?: string) => {
    const timestamp = Date.parse(value ?? "");
    return Number.isNaN(timestamp) ? 0 : timestamp;
  };
  const capturedAtDifference = capturedAt(b.data.capturedAt) - capturedAt(a.data.capturedAt);

  return capturedAtDifference || a.data.title.localeCompare(b.data.title);
});
const allTags = [...new Set(builds.flatMap((build) => build.data.tags))].sort();
const itemCatalogCount = catalog.items.filter((item) => item.imageAvailable && item.image).length;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (asset: string) => `${basePath}${asset.replace(/^\//, "")}`;
const repoUrl =
  import.meta.env.PUBLIC_REPO_URL || "https://github.com/TongShan4869/awesome-pokopia-builds";
---

<BaseLayout>
  <main class="site-shell">
    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav-inner">
        <a class="site-nav-brand" href={basePath}>Awesome Pokopia Builds</a>
        <div class="site-nav-links">
          <a href="#gallery">Builds</a>
          <a href={`${basePath}items/`}>Items</a>
          <a href={`${basePath}nominate/`}>Nominate</a>
          <a class="site-nav-repo" href={repoUrl} rel="noreferrer">GitHub</a>
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Pokopia build scrapbook</p>
        <h1>Awesome Pokopia Builds</h1>
        <p class="hero-text">
          A gallery of awesome Pokemon Pokopia's builds discovered in social media, with item notes
          for later remixing.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#gallery">Browse builds</a>
          <a class="button secondary" href={`${basePath}nominate/`}>Nominate a build</a>
          <a class="button secondary" href={`${basePath}items/`}>Item catalog</a>
        </div>
      </div>
      <div class="hero-specimen" aria-label="Decorative Pokopia gallery preview">
        <div class="specimen-frame">
          <img
            src={assetPath("images/hero/pokopia-pastel-landscape.png")}
            alt="Pastel Pokopia landscape with Pokemon, gardens, trees, and the Pokopia logo"
          />
        </div>
      </div>
    </section>

    <section class="toolbar" aria-label="Gallery summary">
      <div>
        <span class="metric">{builds.length}</span>
        <span class="label">curated builds</span>
      </div>
      <div>
        <span class="metric">{allTags.length}</span>
        <span class="label">themes</span>
      </div>
      <div>
        <span class="metric">{itemCatalogCount}</span>
        <span class="label">catalog figures</span>
      </div>
    </section>

    <div class="catalog-preview-grid">
      <section class="catalog-preview" aria-label="Item catalog preview">
        <div>
          <p class="eyebrow">Item reference</p>
          <h2>Items list for visual inventory notes</h2>
          <p>
            Browse item names and figures alongside builds to create useful visual inventory notes
            for later reference.
          </p>
        </div>
        <a class="button primary" href={`${basePath}items/`}>Open catalog</a>
      </section>

      <section class="catalog-preview" aria-label="Build nominations">
        <div>
          <p class="eyebrow">Know a great build?</p>
          <h2>Send a link for the curator batch</h2>
          <p>
            Found a build you love? Send over the source link and a short note, and we'll take it
            from there.
          </p>
        </div>
        <a class="button primary" href={`${basePath}nominate/`}>Nominate build</a>
      </section>
    </div>

    {builds.length > 0 && (
      <>
        <section class="catalog-controls build-controls" aria-label="Build filters">
          <label>
            <span>Search builds</span>
            <input type="search" id="build-search" placeholder="Garden, cottage, market..." />
          </label>
          <label>
            <span>Theme</span>
            <select id="theme-filter">
              <option value="">All themes</option>
              {allTags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>
        </section>
        <p class="catalog-result-count build-result-count" id="build-result-count">
          {builds.length} visible builds
        </p>
      </>
    )}

    <section id="gallery" class="gallery" aria-label="Pokopia build gallery">
      {builds.length === 0 ? (
        <div class="empty-state">
          <p class="eyebrow">No builds exported yet</p>
          <h2>Drop in your first social link locally.</h2>
          <p>
            Run <code>corepack pnpm ingest "&lt;url&gt;"</code>, review the private curation
            draft, then export a public build page when the screenshot and notes feel right.
          </p>
        </div>
      ) : (
        builds.map((build) => (
          <a
            class="build-card"
            href={`${basePath}builds/${build.slug}/`}
            data-build-card
            data-title={build.data.title.toLowerCase()}
            data-summary={build.data.summary.toLowerCase()}
            data-creator={build.data.creator.toLowerCase()}
            data-platform={build.data.platform.toLowerCase()}
            data-tags={JSON.stringify(build.data.tags.map((tag) => tag.toLowerCase()))}
          >
            <img src={assetPath(build.data.heroImage)} alt={`${build.data.title} full build screenshot`} loading="lazy" />
            <div class="build-card-copy">
              <p>{build.data.platform} · {build.data.creator}</p>
              <h2>{build.data.title}</h2>
              <span>{build.data.summary}</span>
            </div>
            <div class="chip-row">
              {build.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        ))
      )}
    </section>
  </main>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#build-search");
    const themeFilter = document.querySelector<HTMLSelectElement>("#theme-filter");
    const resultCount = document.querySelector<HTMLElement>("#build-result-count");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-build-card]")];

    function updateGallery() {
      const query = searchInput?.value.trim().toLowerCase() ?? "";
      const theme = themeFilter?.value.toLowerCase() ?? "";
      let visibleCount = 0;

      for (const card of cards) {
        const haystack = [
          card.dataset.title,
          card.dataset.summary,
          card.dataset.creator,
          card.dataset.platform,
          card.dataset.tags,
        ].join(" ");
        const tags = JSON.parse(card.dataset.tags ?? "[]");
        const matchesQuery = query === "" || haystack.includes(query);
        const matchesTheme = theme === "" || tags.includes(theme);
        const visible = matchesQuery && matchesTheme;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      if (resultCount) {
        resultCount.textContent = `${visibleCount} visible ${visibleCount === 1 ? "build" : "builds"}`;
      }
    }

    searchInput?.addEventListener("input", updateGallery);
    themeFilter?.addEventListener("change", updateGallery);
    updateGallery();
  </script>
</BaseLayout>
