---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import catalog from "../../../data/pokopia-item-catalog.json";
import { formatPlatform } from "../../utils/platforms";
import { tagSlug } from "../../utils/tags";

export async function getStaticPaths() {
  const builds = await getCollection("builds");
  return builds.map((build) => ({
    params: { slug: build.slug },
    props: { build },
  }));
}

const { build } = Astro.props;
const { Content } = await render(build);
const displayedItems =
  build.data.inferredItems.length > 0
    ? build.data.inferredItems
    : build.data.items.map((item) => ({
        name: item,
        image: "",
        evidence: undefined,
      }));
const catalogByName = new Map(catalog.items.map((item) => [item.name, item]));
const buildCatalogItems = build.data.items
  .map((item) => catalogByName.get(item))
  .filter((item) => item !== undefined);
const itemSections = [...new Set(buildCatalogItems.map((item) => item.section))].sort();
const itemTags = [...new Set(buildCatalogItems.flatMap((item) => item.tags))].sort();
const sourcePublishedDate = build.data.sourcePublishedAt
  ? new Intl.DateTimeFormat("en", {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(build.data.sourcePublishedAt))
  : null;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (asset: string) => `${basePath}${asset.replace(/^\//, "")}`;
const heroGalleryImage = build.data.galleryImages.find((image) => image.src === build.data.heroImage);
const galleryImages = [
  {
    src: build.data.heroImage,
    alt: heroGalleryImage?.alt ?? `${build.data.title} full build screenshot`,
    caption: heroGalleryImage?.caption,
  },
  ...build.data.galleryImages.filter((image) => image.src !== build.data.heroImage),
];
const firstGalleryImage = galleryImages[0];
const platformLabel = formatPlatform(build.data.platform);
const site = Astro.site ?? new URL("https://tongshan4869.github.io");
const shareUrl = new URL(`${basePath}builds/${build.slug}/`, site).toString();
const shareTitle = `${build.data.title} · awesome-pokopia-builds`;
const shareText = `${build.data.title}: ${build.data.summary}`;
const encodedShareUrl = encodeURIComponent(shareUrl);
const encodedShareTitle = encodeURIComponent(shareTitle);
const encodedShareText = encodeURIComponent(shareText);
const socialShareLinks = [
  {
    label: "Discord",
    icon: "D",
    className: "share-icon-discord",
    copy: true,
  },
  {
    label: "X",
    icon: "X",
    className: "share-icon-x",
    href: `https://twitter.com/intent/tweet?url=${encodedShareUrl}&text=${encodedShareText}`,
  },
  {
    label: "Reddit",
    icon: "r",
    className: "share-icon-reddit",
    href: `https://www.reddit.com/submit?url=${encodedShareUrl}&title=${encodedShareTitle}`,
  },
  {
    label: "Bluesky",
    icon: "b",
    className: "share-icon-bluesky",
    href: `https://bsky.app/intent/compose?text=${encodedShareText}%20${encodedShareUrl}`,
  },
];
---

<BaseLayout
  title={`${build.data.title} · awesome-pokopia-builds`}
  description={build.data.summary}
  image={build.data.heroImage}
  imageWidth={1536}
  imageHeight={1024}
  type="article"
>
  <main class="detail-shell">
    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav-inner">
        <a class="site-nav-brand" href={basePath}>
          <span>Pokopia</span>
          <strong>Builds</strong>
        </a>
        <div class="site-nav-links">
          <a href={`${basePath}#gallery`}>Builds</a>
          <a href={`${basePath}items/`}>Items</a>
          <a href={`${basePath}nominate/`}>Nominate</a>
          <div class="share-menu nav-share-menu" data-share-menu>
            <button class="site-nav-share" type="button" aria-expanded="false" aria-controls="share-panel" data-share-trigger>
              Share
            </button>
          </div>
        </div>
      </div>
    </nav>

    <a class="back-link" href={basePath} aria-label="Back to gallery">
      <span aria-hidden="true">←</span>
      Back to gallery
    </a>
    <article class="build-detail">
      <section class="detail-hero">
        <header class="detail-header">
          <div class="detail-copy">
            <div class="detail-meta-row">
              <p class="eyebrow">{platformLabel} · {build.data.creator}</p>
            </div>
            <h1>
              <a class="detail-title-link" href={build.data.sourceUrl} target="_blank" rel="noreferrer">
                {build.data.title}
              </a>
            </h1>
            <p class="detail-summary">{build.data.summary}</p>
          </div>
        </header>

        <section class="build-gallery" data-build-gallery>
          <div
            class="gallery-stage"
            tabindex={galleryImages.length > 1 ? "0" : undefined}
            aria-label={galleryImages.length > 1 ? "Build screenshot gallery" : undefined}
          >
            <img
              class="detail-image"
              src={assetPath(firstGalleryImage.src)}
              alt={firstGalleryImage.alt ?? `${build.data.title} build screenshot`}
              data-gallery-main
            />
            {galleryImages.length > 1 && (
              <>
                <button
                  class="gallery-arrow gallery-arrow-prev"
                  type="button"
                  aria-label="Show previous screenshot"
                  data-gallery-step="-1"
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <button
                  class="gallery-arrow gallery-arrow-next"
                  type="button"
                  aria-label="Show next screenshot"
                  data-gallery-step="1"
                >
                  <span aria-hidden="true">›</span>
                </button>
                <div class="gallery-dots" aria-label="Build screenshots">
                  {galleryImages.map((image, index) => (
                    <button
                      class:list={["gallery-dot", { "is-active": index === 0 }]}
                      type="button"
                      aria-label={`Show screenshot ${index + 1}`}
                      aria-pressed={index === 0 ? "true" : "false"}
                      data-gallery-src={assetPath(image.src)}
                      data-gallery-alt={image.alt ?? `${build.data.title} build screenshot ${index + 1}`}
                      data-gallery-caption={image.caption ?? ""}
                      data-gallery-index={index}
                    ></button>
                  ))}
                </div>
              </>
            )}
          </div>
        </section>
      </section>

      <section class="detail-grid">
        <div class="notes prose">
          <Content />
          <section class="source-card">
            <h2>Source</h2>
            <dl>
              <div>
                <dt>Post title</dt>
                <dd>{build.data.sourceTitle ?? build.data.title}</dd>
              </div>
              <div>
                <dt>Posted by</dt>
                <dd>
                  {build.data.sourceAuthorUrl ? (
                    <a href={build.data.sourceAuthorUrl} target="_blank" rel="noreferrer">
                      {build.data.sourceAuthor ?? build.data.creator}
                    </a>
                  ) : (
                    build.data.sourceAuthor ?? build.data.creator
                  )}
                </dd>
              </div>
              {sourcePublishedDate && (
                <div>
                  <dt>Published</dt>
                  <dd>{sourcePublishedDate}</dd>
                </div>
              )}
              <div>
                <dt>Original link</dt>
                <dd>
                  <a href={build.data.sourceUrl} target="_blank" rel="noreferrer">
                    {build.data.sourceUrl}
                  </a>
                </dd>
              </div>
            </dl>
          </section>
          <section class="item-panel build-item-section">
            <h2>Items that may be used in this build</h2>
            {displayedItems.length > 0 ? (
              <ul class="inferred-item-grid">
                {displayedItems.map((item) => (
                  <li>
                    <a class="inferred-item-card" href={`${basePath}items/?q=${encodeURIComponent(item.name)}`}>
                    {item.image && (
                      <img src={assetPath(item.image)} alt={`${item.name} item figure`} loading="lazy" />
                    )}
                    <div>
                      <span>{item.name}</span>
                      {item.evidence && <p>{item.evidence}</p>}
                    </div>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p>No public item notes yet.</p>
            )}
          </section>
        </div>
        <aside class="item-panel meta-panel">
          <h2>Build details</h2>
          <dl class="meta-list">
            <div>
              <dt>Build creator</dt>
              <dd>{build.data.creator}</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>{platformLabel}</dd>
            </div>
          </dl>

          <h2>Themes</h2>
          <div class="chip-row">
            {build.data.tags.map((tag) => (
              <a href={`${basePath}tags/${tagSlug(tag)}/`}>{tag}</a>
            ))}
          </div>

          {itemSections.length > 0 && (
            <>
              <h2>Item sections</h2>
              <div class="chip-row">
                {itemSections.map((section) => <span>{section}</span>)}
              </div>
            </>
          )}

          {itemTags.length > 0 && (
            <>
              <h2>Item tags</h2>
              <div class="chip-row">
                {itemTags.map((tag) => <span>{tag}</span>)}
              </div>
            </>
          )}
        </aside>
      </section>
    </article>
  </main>

  <div class="share-panel" id="share-panel" data-share-panel hidden>
    <div class="share-backdrop" data-share-close></div>
    <section class="share-dialog" role="dialog" aria-modal="true" aria-labelledby="share-title">
      <button class="share-close" type="button" aria-label="Close share dialog" data-share-close>
        <span aria-hidden="true">×</span>
      </button>
      <h2 id="share-title">Share this build</h2>
      <div class="share-links" aria-label="Social share links">
        {socialShareLinks.map((link) => (
          link.copy ? (
            <button type="button" data-share-copy>
              <span class:list={["share-icon", link.className]} aria-hidden="true">{link.icon}</span>
              <span>{link.label}</span>
            </button>
          ) : (
            <a href={link.href} target="_blank" rel="noreferrer">
              <span class:list={["share-icon", link.className]} aria-hidden="true">{link.icon}</span>
              <span>{link.label}</span>
            </a>
          )
        ))}
      </div>
      <label class="share-copy">
        <span>Share link</span>
        <input type="url" value={shareUrl} readonly data-share-input />
      </label>
      <button class="button primary share-copy-button" type="button" data-share-copy>
        Copy link
      </button>
      <p class="share-status" aria-live="polite" data-share-status></p>
    </section>
  </div>
</BaseLayout>

<script>
  const shareTrigger = document.querySelector<HTMLButtonElement>("[data-share-trigger]");
  const sharePanel = document.querySelector<HTMLElement>("[data-share-panel]");
  const shareInput = document.querySelector<HTMLInputElement>("[data-share-input]");
  const shareCopyControls = [...document.querySelectorAll<HTMLButtonElement>("[data-share-copy]")];
  const shareStatus = document.querySelector<HTMLElement>("[data-share-status]");
  const shareCloseControls = [...document.querySelectorAll<HTMLElement>("[data-share-close]")];

  function setSharePanel(open: boolean) {
    if (!sharePanel || !shareTrigger) return;

    sharePanel.hidden = !open;
    shareTrigger.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("is-share-open", open);
    if (!open && shareStatus) shareStatus.textContent = "";
    if (open) {
      sharePanel.querySelector<HTMLElement>(".share-close")?.focus();
    }
  }

  shareTrigger?.addEventListener("click", () => {
    setSharePanel(Boolean(sharePanel?.hidden));
  });

  async function copyShareLink(message: string) {
    if (!shareInput || !shareStatus) return;

    try {
      await navigator.clipboard.writeText(shareInput.value);
      shareStatus.textContent = message;
    } catch {
      shareInput.focus();
      shareInput.select();
      shareStatus.textContent = "Select and copy.";
    }
  }

  shareCopyControls.forEach((control) => {
    control.addEventListener("click", () => {
      copyShareLink(control.closest(".share-links") ? "Copied for Discord." : "Copied.");
    });
  });

  shareCloseControls.forEach((control) => {
    control.addEventListener("click", () => setSharePanel(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setSharePanel(false);
  });

  document.querySelectorAll<HTMLElement>("[data-build-gallery]").forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-src]")];
    const arrows = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-step]")];
    const stage = gallery.querySelector<HTMLElement>(".gallery-stage");
    let activeIndex = 0;

    const showImage = (nextIndex: number) => {
      if (!mainImage || buttons.length === 0) return;

      activeIndex = (nextIndex + buttons.length) % buttons.length;
      const activeButton = buttons[activeIndex];
      mainImage.src = activeButton.dataset.gallerySrc ?? mainImage.src;
      mainImage.alt = activeButton.dataset.galleryAlt ?? mainImage.alt;
      buttons.forEach((item, index) => {
        const isActive = index === activeIndex;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => showImage(index));
    });

    arrows.forEach((arrow) => {
      arrow.addEventListener("click", () => showImage(activeIndex + Number(arrow.dataset.galleryStep ?? 0)));
    });

    stage?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showImage(activeIndex - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        showImage(activeIndex + 1);
      }
    });
  });
</script>
